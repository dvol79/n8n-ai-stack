# ============================================================
#  n8n + PostgreSQL — шаблон переменных окружения
#  Скопируйте в .env и заполните, либо запустите ./init.sh
# ============================================================

# ------------------------------------------------------------
#  PostgreSQL
# ------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_CONTAINER_NAME=n8n_ai_postgres
# Внешний порт PostgreSQL (для отладки через psql с хоста).
# Внутри docker-сети n8n всегда ходит на postgres:5432.
# Оставьте пустым или закомментируйте, чтобы не открывать порт наружу.
POSTGRES_PORT=5432


# ------------------------------------------------------------
#  Qdrant
# ------------------------------------------------------------
QDRANT_API_KEY=__GENERATE__


# ------------------------------------------------------------
#  LiteLLM (Универсальный шлюз)
# ------------------------------------------------------------
LITELLM_MASTER_KEY=__GENERATE__
# Укажите здесь ваш реальный ключ от провайдера (OpenRouter, DeepSeek, OpenAI и т.д.)
PROVIDER_API_KEY=вставьте_ваш_реальный_ключ_здесь
# Модель по умолчанию (например, для OpenRouter: openrouter/deepseek/deepseek-chat)
DEFAULT_MODEL=openrouter/deepseek/deepseek-chat


# ------------------------------------------------------------
#  n8n
# ------------------------------------------------------------
# Ключ шифрования n8n — ОБЯЗАТЕЛЬНО сохраните, потеря = потеря credentials
N8N_ENCRYPTION_KEY=__GENERATE__
# Хост и протокол (для локальной разработки — localhost/http)
N8N_HOST=localhost
N8N_PROTOCOL=http
# Порт, на котором n8n будет доступен на хосте
N8N_PORT=5678

# URL для вебхуков (должен совпадать с тем, как вы обращаетесь к n8n)
WEBHOOK_URL=http://localhost:5678/

# Часовой пояс (используется в Schedule-узлах)
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Логирование: info | warn | error | debug
N8N_LOG_LEVEL=info

# Отключить телеметрию (по желанию)
N8N_DIAGNOSTICS_ENABLED=false

# Базовый логин/пароль owner-аккаунта (опционально — можно создать через UI).
# Оставьте пустыми, если хотите зарегистрироваться вручную при первом входе.
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=__GENERATE__


# ------------------------------------------------------------
#  Бэкапы (используются backup.sh)
# ------------------------------------------------------------
# Сколько дней хранить дампы
BACKUP_RETENTION_DAYS=14
